---
import type { BlocksRendererProps } from './types';
import Block from './Block.astro';

type Props = BlocksRendererProps;

const {
  content,
  blocks,
  modifiers,
  diagramTheme,
  clientMermaid,
  codeTheme,
  codeCopyButton,
  blockPlugins,
} = Astro.props;
const isValid = Array.isArray(content) && content.length > 0;
---

{isValid &&
  content.map((block, index) => (
    <Block
      block={block}
      blocks={blocks}
      modifiers={modifiers}
      diagramTheme={diagramTheme}
      clientMermaid={clientMermaid}
      codeTheme={codeTheme}
      codeCopyButton={codeCopyButton}
      blockPlugins={blockPlugins}
      index={index}
    />
  ))}
