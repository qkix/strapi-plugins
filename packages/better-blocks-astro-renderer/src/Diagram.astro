---
import {
  applyDiagramTheme,
  resolveDiagramPalette,
  toPeleWrapperStyle,
} from '@qkix/better-blocks-core';
import { render as renderPele } from 'pele';
import type { CustomBlocksConfig, DiagramNode, DiagramTheme } from './types';
import MermaidScript from './MermaidScript.astro';
import { warnOnce } from './deprecation';

interface Props {
  node: DiagramNode;
  blocks?: CustomBlocksConfig;
  diagramTheme?: DiagramTheme;
  clientMermaid?: boolean;
}

const { node, blocks, diagramTheme, clientMermaid } = Astro.props;

const source = node.value ?? '';
const format = node.format ?? 'mermaid';
const DiagramComp = blocks?.diagram;

// A `%%{init}%%` directive in the source wins, as it did under mermaid.js, so
// diagrams written for mermaid keep their author's colors. Otherwise
// `diagramTheme` (a built-in palette name or custom colors), else the shared
// default: mermaid.js's lavender look, which every renderer and the editor use.
const colors = resolveDiagramPalette(source, diagramTheme);

if (clientMermaid && !DiagramComp) {
  warnOnce(
    'clientMermaid',
    '`clientMermaid` is deprecated and will be removed in a future release. Diagrams render ' +
      'with Pele by default, as in the React and Vue renderers and the Strapi editor. To keep ' +
      'mermaid.js, supply your own `diagram` renderer via `blocks.diagram` (see the README).'
  );
}

// Pele colors its SVG through `--pele-*` custom properties, so the palette is
// a style on the wrapper rather than part of the SVG.
const wrapperStyle = toPeleWrapperStyle(colors);

// An `accTitle` becomes `<title id="pele-title">` plus `aria-labelledby`, under
// the same default prefix in every diagram, so with two on one page the second
// is announced with the first one's title. A hash of the source keeps the
// prefix unique per diagram and stable between builds.
function idPrefixFor(text: string): string {
  let hash = 0x811c9dc5;
  for (let i = 0; i < text.length; i++) {
    hash = Math.imul(hash ^ text.charCodeAt(i), 0x01000193);
  }
  return `bb-pele-${(hash >>> 0).toString(36)}`;
}

// Pele renders Mermaid to an SVG string synchronously on the server - no
// browser, no client-side hydration - and covers every diagram type built into
// Mermaid. It throws on empty or invalid input; in that case we fall back to
// the raw source in a <pre> so content is never lost.
//
// It has its own layout and visual style rather than mermaid.js's, so a
// diagram is laid out a little differently than mermaid draws it.
// `clientMermaid` trades this component's zero-JS default for mermaid.js
// proper, rendered after load.
let svg: string | null = null;
if (!DiagramComp && source && !clientMermaid) {
  try {
    svg = renderPele(source, { idPrefix: idPrefixFor(source) }).svg;
  } catch {
    svg = null;
  }
}

// In client mode the theme travels with the source as a mermaid `%%{init}%%`
// directive, because mermaid's own config is global and shared by every diagram
// on the page.
const clientSource = clientMermaid ? applyDiagramTheme(source, diagramTheme) : source;

const Custom = DiagramComp as any;
---

{Custom ? (
  <Custom code={source} format={format} />
) : clientMermaid ? (
  <>
    <pre class="mermaid-source" data-bb-mermaid set:text={clientSource} />
    <MermaidScript />
  </>
) : svg !== null ? (
  <div class="mermaid-diagram" style={wrapperStyle} set:html={svg} />
) : (
  <pre class="mermaid-source">{source}</pre>
)}
