{
  "name": "@qkix/better-blocks-react-renderer",
  "version": "0.19.0",
  "description": "React renderer for Strapi v5 Blocks content with full Better Blocks plugin support - colors, tables, to-do lists, media embeds, alignment, and more",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ts": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qkix/better-blocks-core": "workspace:^",
    "katex": "^0.19.1",
    "pele": "^1.12.0",
    "shiki": "^4.5.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@qkix/eslint-config": "workspace:*",
    "@qkix/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "strapi",
    "strapi-v5",
    "blocks",
    "blocks-renderer",
    "react",
    "renderer",
    "rich-text",
    "better-blocks",
    "color",
    "highlight",
    "text-color",
    "background-color",
    "katex",
    "latex",
    "math",
    "mermaid",
    "diagram",
    "cms",
    "headless-cms"
  ],
  "license": "MIT",
  "author": "qkix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkix/strapi-plugins.git",
    "directory": "packages/better-blocks-react-renderer"
  },
  "bugs": {
    "url": "https://github.com/qkix/strapi-plugins/issues"
  },
  "homepage": "https://github.com/qkix/strapi-plugins#readme",
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "nx": {
    "tags": [
      "scope:renderer"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
