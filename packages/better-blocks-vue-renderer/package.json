{
  "name": "@qkix/better-blocks-vue-renderer",
  "version": "0.2.2",
  "description": "Vue 3 renderer for Strapi v5 Blocks content with full Better Blocks plugin support - colors, tables, to-do lists, media embeds, alignment, and more. Server-rendered in Nuxt, and just as happy in a plain Vue app.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./nuxt": {
      "types": "./nuxt/module.d.ts",
      "default": "./nuxt/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "nuxt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qkix/better-blocks-core": "workspace:^",
    "katex": "^0.16.11",
    "mermaid": "^11.4.0",
    "shiki": "^1.24.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.15.0",
    "@nuxt/schema": "^3.15.0",
    "@qkix/eslint-config": "workspace:*",
    "@qkix/tsconfig": "workspace:*",
    "@types/katex": "^0.16.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "strapi",
    "strapi-v5",
    "blocks",
    "blocks-renderer",
    "vue",
    "vue3",
    "nuxt",
    "renderer",
    "rich-text",
    "better-blocks",
    "color",
    "highlight",
    "text-color",
    "background-color",
    "katex",
    "latex",
    "math",
    "mermaid",
    "diagram",
    "cms",
    "headless-cms"
  ],
  "license": "MIT",
  "author": "qkix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkix/strapi-plugins.git",
    "directory": "packages/better-blocks-vue-renderer"
  },
  "bugs": {
    "url": "https://github.com/qkix/strapi-plugins/issues"
  },
  "homepage": "https://github.com/qkix/strapi-plugins#readme",
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "nx": {
    "tags": [
      "scope:renderer"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
