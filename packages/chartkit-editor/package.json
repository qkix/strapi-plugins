{
  "name": "@qkix/chartkit-editor",
  "version": "0.3.0",
  "description": "The Chartkit chart editor for the Strapi admin - a data grid, CSV paste and live preview, shared by the standalone custom field and the Better Blocks block",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./block": {
      "import": {
        "types": "./dist/block.d.mts",
        "default": "./dist/block.mjs"
      },
      "require": {
        "types": "./dist/block.d.ts",
        "default": "./dist/block.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qkix/chartkit-core": "workspace:^"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "styled-components": "^6.0.0",
    "@strapi/admin": "^5.0.0",
    "slate": "0.94.1",
    "slate-react": "0.98.3"
  },
  "devDependencies": {
    "@qkix/eslint-config": "workspace:*",
    "@qkix/tsconfig": "workspace:*",
    "@strapi/admin": "^5.12.5",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^10.8.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "slate": "0.94.1",
    "slate-react": "0.98.3",
    "styled-components": "^6.1.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "chart",
    "charts",
    "editor",
    "strapi",
    "chartkit"
  ],
  "license": "MIT",
  "author": "qkix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkix/strapi-plugins.git",
    "directory": "packages/chartkit-editor"
  },
  "bugs": {
    "url": "https://github.com/qkix/strapi-plugins/issues"
  },
  "homepage": "https://github.com/qkix/strapi-plugins#readme",
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "nx": {
    "tags": [
      "scope:editor"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@strapi/admin": {
      "optional": true
    },
    "slate": {
      "optional": true
    },
    "slate-react": {
      "optional": true
    }
  }
}
