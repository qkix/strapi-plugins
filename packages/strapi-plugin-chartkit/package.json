{
  "name": "@qkix/strapi-plugin-chartkit",
  "version": "0.3.0",
  "description": "Charts for Strapi v5, rendered as server-side SVG with no client-side JavaScript",
  "strapi": {
    "kind": "plugin",
    "name": "chartkit",
    "displayName": "Chartkit",
    "description": "Charts for Strapi v5, rendered as server-side SVG with no client-side JavaScript"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "chart",
    "charts",
    "chartkit",
    "svg",
    "custom-field",
    "cms",
    "headless-cms",
    "data-visualization"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && strapi-plugin build --minify",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "typecheck": "tsc -p admin/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qkix/chartkit-core": "workspace:^",
    "@qkix/chartkit-editor": "workspace:^"
  },
  "devDependencies": {
    "@qkix/eslint-config": "workspace:*",
    "@qkix/strapi-test-harness": "workspace:*",
    "@qkix/tsconfig": "workspace:*",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.12.5",
    "@strapi/typescript-utils": "^5.12.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.8.1",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@strapi/admin": "^5.0.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-intl": "^6.0.0 || ^7.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "license": "MIT",
  "author": "qkix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkix/strapi-plugins.git",
    "directory": "packages/strapi-plugin-chartkit"
  },
  "bugs": {
    "url": "https://github.com/qkix/strapi-plugins/issues"
  },
  "homepage": "https://github.com/qkix/strapi-plugins#readme",
  "nx": {
    "tags": [
      "scope:plugin"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
