{
  "name": "@qkix/strapi-test-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Boots a real Strapi instance against a throwaway SQLite database so plugin server code can be tested against the actual lifecycle, not a mock of it",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vitest-preset": {
      "types": "./src/vitest-preset.d.ts",
      "default": "./src/vitest-preset.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@qkix/eslint-config": "workspace:*",
    "@qkix/tsconfig": "workspace:*",
    "@strapi/strapi": "^5.59.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "nx": {
    "tags": [
      "scope:tooling"
    ]
  }
}
